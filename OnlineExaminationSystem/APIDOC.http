###
POST http://127.0.0.1:8000/question/
Content-Type:application/json

{
    "question":"Which keyword is used to define a function in Python?",
    "option_a":"def",
    "option_b":"return",
    "option_c":"func",
    "option_d":"para",
    "correct_answer":"def"
}
#questions added one by one

###
GET http://127.0.0.1:8000/question/2
ACCEPT:application/json
#question retrived with id

###
PUT http://127.0.0.1:8000/question/2
Content-Type:application/json

{
  "question": "Output of 3**2",
  "option_a": "9",
  "option_b": "27",
  "option_c": "26",
  "option_d": "14",
  "correct_answer": "27"
}
#updated successfully

